{
  "name": "office-wars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/game/*.test.ts",
    "format": "prettier --write src",
    "server": "node --env-file-if-exists=server/.env --import tsx server/index.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "deploy:web": "sh scripts/deploy-web.sh",
    "deploy:server": "sh scripts/deploy-server.sh",
    "test:multiplayer": "node --import tsx scripts/multiplayer-smoke.ts",
    "test:cache": "node --test scripts/cache.test.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.56.2",
    "@colyseus/core": "~0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "~0.16.5",
    "colyseus.js": "~0.16.22",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
